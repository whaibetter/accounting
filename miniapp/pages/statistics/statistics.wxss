.stats-page {
  padding: 24rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
}

/* 周期切换 */
.period-bar {
  padding: 12rpx 28rpx;
}

.period-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.period-btn {
  font-size: 28rpx;
  color: var(--color-primary);
  padding: 10rpx 20rpx;
}

.period-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.period-type-tabs {
  display: flex;
  margin-bottom: 8rpx;
}

.pt-tab {
  font-size: 24rpx;
  color: var(--text-muted);
  padding: 4rpx 20rpx;
  border-radius: 16rpx;
  margin: 0 8rpx;
}

.pt-tab.active {
  background-color: var(--color-primary);
  color: #FFFFFF;
}

.period-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 概览 */
.stats-overview {
  padding: 32rpx 24rpx;
}

.so-row {
  display: flex;
}

.so-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.so-val {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.so-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* Tab */
.chart-tabs {
  display: flex;
  background-color: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.chart-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--text-secondary);
}

.chart-tab.active {
  background-color: var(--color-primary);
  color: #FFFFFF;
}

/* 分类列表 */
.cat-stat-list {
  margin-bottom: 24rpx;
}

.cat-stat-item {
  background-color: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.csi-left {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.csi-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.csi-name {
  font-size: 28rpx;
  font-weight: 500;
}

.csi-right {
  padding-left: 8rpx;
}

.csi-bar-wrap {
  height: 12rpx;
  background-color: var(--bg-input);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.csi-bar {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

.csi-info {
  display: flex;
  justify-content: space-between;
}

.csi-amount {
  font-size: 26rpx;
  font-weight: 500;
}

.csi-pct {
  font-size: 24rpx;
  color: var(--text-muted);
}

.empty-hint {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-muted);
  font-size: 28rpx;
}
