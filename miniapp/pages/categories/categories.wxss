.page-con { padding: 24rpx; padding-bottom: 100rpx; }

.ct-tabs { display: flex; padding: 6rpx 28rpx; margin-bottom: 24rpx; }
.ct-tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 28rpx; color: var(--text-secondary); border-radius: var(--radius-sm); }
.ct-tab.active { background: var(--color-primary); color: #FFF; }

.cat-node { padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.cn-main { display: flex; align-items: center; }
.cn-icon { font-size: 32rpx; margin-right: 16rpx; }
.cn-name { flex: 1; font-size: 30rpx; font-weight: 500; }
.cn-btns { display: flex; gap: 16rpx; }
.cn-btn { font-size: 24rpx; color: var(--color-primary); }
.cn-btn.danger { color: var(--color-expense); }

.cn-children { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid var(--border-color); padding-left: 40rpx; }
.cn-child { display: flex; align-items: center; padding: 16rpx 0; }
.cn-c-icon { font-size: 28rpx; margin-right: 12rpx; }
.cn-c-name { flex: 1; font-size: 28rpx; color: var(--text-secondary); }

.add-btn { text-align: center; color: var(--color-primary); font-size: 30rpx; padding: 32rpx; }
