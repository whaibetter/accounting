.bills-container {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 28rpx;
}

.month-btn {
  font-size: 28rpx;
  color: var(--color-primary);
  padding: 10rpx 20rpx;
}

.month-text {
  font-size: 34rpx;
  font-weight: 600;
  padding: 0 40rpx;
  color: var(--text-primary);
}

.filter-bar {
  padding: 20rpx 28rpx;
}

.filter-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.filter-count {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.filter-toggle {
  font-size: 26rpx;
  color: var(--color-primary);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--color-primary);
}

.filter-toggle.active {
  background-color: var(--color-primary);
  color: #FFFFFF;
}

.filter-panel {
  margin-top: 24rpx;
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-section-title {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-tag {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  background-color: var(--bg-input);
  color: var(--text-secondary);
  font-size: 26rpx;
}

.filter-tag.active {
  background-color: var(--color-primary);
  color: #FFFFFF;
}

.filter-actions {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
}

.filter-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--radius-md);
  font-size: 28rpx;
}

.filter-btn.reset {
  background-color: var(--bg-input);
  color: var(--text-secondary);
}

.filter-btn.apply {
  background-color: var(--color-primary);
  color: #FFFFFF;
}

/* 账单卡片 */
.bill-list {
  margin-top: 8rpx;
}

.bill-card {
  background-color: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.bill-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bill-left {
  display: flex;
  align-items: center;
}

.bill-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.bill-name {
  font-size: 30rpx;
  font-weight: 500;
  display: block;
}

.bill-date {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  display: block;
}

.bill-right {
  text-align: right;
}

.bill-amount {
  font-size: 34rpx;
  font-weight: 600;
  display: block;
}

.bill-account {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  display: block;
}

.bill-extra {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.bill-remark {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}

.bill-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tag-dot {
  font-size: 22rpx;
  color: #FFFFFF;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.bill-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.bill-action {
  font-size: 24rpx;
  color: var(--color-primary);
}

.bill-action.danger {
  color: var(--color-expense);
}

.load-more {
  text-align: center;
  padding: 32rpx 0;
}
