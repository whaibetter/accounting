<view class="home-container">
  <!-- 月份切换 -->
  <view class="month-bar card">
    <view class="month-btn" bindtap="onPrevMonth">◀</view>
    <text class="month-text">{{month}}</text>
    <view class="month-btn" bindtap="onNextMonth">▶</view>
  </view>

  <!-- 收支概览 -->
  <view class="overview card">
    <view class="overview-row">
      <view class="overview-item">
        <text class="overview-label">收入</text>
        <text class="overview-value text-income">{{overview.total_income.toFixed(2)}}</text>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <text class="overview-label">支出</text>
        <text class="overview-value text-expense">{{overview.total_expense.toFixed(2)}}</text>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <text class="overview-label">结余</text>
        <text class="overview-value {{overview.balance >= 0 ? 'text-income' : 'text-expense'}}">{{overview.balance.toFixed(2)}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-actions card">
    <view class="action-item" bindtap="onAddBill">
      <view class="action-icon expense-icon">−</view>
      <text class="action-label">记一笔</text>
    </view>
    <view class="action-item" bindtap="onViewBills">
      <view class="action-icon bills-icon">📋</view>
      <text class="action-label">账单</text>
    </view>
    <view class="action-item" bindtap="onViewStats">
      <view class="action-icon stats-icon">📊</view>
      <text class="action-label">统计</text>
    </view>
  </view>

  <!-- 最近账单 -->
  <view class="section-header">
    <text class="section-title">最近账单</text>
    <text class="section-count">共 {{overview.bill_count}} 笔</text>
  </view>

  <view wx:if="{{recentBills.length > 0}}" class="bill-list">
    <view
      wx:for="{{recentBills}}"
      wx:key="id"
      class="bill-item"
      bindtap="onViewBills"
    >
      <view class="bill-left">
        <view class="bill-category-icon">{{item.category_icon || '📌'}}</view>
        <view class="bill-info">
          <text class="bill-category">{{item.category_name}}</text>
          <text class="bill-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
        </view>
      </view>
      <view class="bill-right">
        <text class="bill-amount {{item.type === 2 ? 'text-income' : 'text-expense'}}">
          {{item.type === 2 ? '+' : '-'}}{{item.amount.toFixed(2)}}
        </text>
      </view>
    </view>
  </view>

  <view wx:else class="empty-hint">
    <text>暂无账单记录</text>
  </view>

  <!-- 悬浮记账按钮 -->
  <view class="fab" bindtap="onAddBill">
    <text>+</text>
  </view>
</view>
