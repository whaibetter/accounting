.home-container {
  padding: 24rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 28rpx;
}

.month-btn {
  font-size: 28rpx;
  color: var(--color-primary);
  padding: 10rpx 20rpx;
}

.month-text {
  font-size: 34rpx;
  font-weight: 600;
  padding: 0 40rpx;
  color: var(--text-primary);
}

.overview {
  padding: 32rpx 24rpx;
}

.overview-row {
  display: flex;
  align-items: center;
}

.overview-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: var(--border-color);
}

.overview-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.overview-value {
  font-size: 36rpx;
  font-weight: 700;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 16rpx;
}

.expense-icon {
  background: linear-gradient(135deg, #818CF8, #6366F1);
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 600;
}

.bills-icon, .stats-icon {
  background-color: var(--bg-input);
  font-size: 36rpx;
}

.action-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.section-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

.bill-list {
  margin-bottom: 24rpx;
}

.bill-item {
  background-color: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bill-left {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.bill-category-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.bill-info {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.bill-category {
  font-size: 30rpx;
  font-weight: 500;
}

.bill-remark {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.empty-hint {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-muted);
  font-size: 28rpx;
}
