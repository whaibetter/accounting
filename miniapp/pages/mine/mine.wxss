.mine-page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 36rpx 28rpx;
  margin-bottom: 32rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 24rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  display: block;
}

.user-sub {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  display: block;
}

.menu-section {
  margin-bottom: 24rpx;
}

.menu-title {
  font-size: 24rpx;
  color: var(--text-muted);
  padding: 0 8rpx 16rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-muted);
}

.menu-divider {
  height: 1rpx;
  background-color: var(--border-color);
  margin: 0 8rpx;
}

.menu-item.danger .menu-text {
  color: var(--color-expense);
}

.app-version {
  text-align: center;
  padding: 48rpx 0;
}
